{
  "name": "sensei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite",
    "server": "node server/server.js",
    "electron": "electron electron/main.cjs",
    "app": "concurrently \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.23.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "openai": "^5.19.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.15.0",
    "vite": "^7.3.6",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.sensei.study",
    "productName": "SENSEI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
